{
  "name": "nocturne",
  "private": true,
  "type": "module",
  "description": "NOCTURNE - a hand-tracked WebXR experience for Meta Quest. Static ES-module site; tools/harness is the headless Playwright test harness.",
  "scripts": {
    "harness": "node tools/harness/run.mjs",
    "harness:fixture": "node tools/harness/run.mjs --url /tools/harness/fixtures/minimal/index.html",
    "serve": "node tools/harness/serve.mjs",
    "scenario": "node tools/harness/scenario.mjs",
    "sim-probe": "node tools/harness/sim-probe.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
