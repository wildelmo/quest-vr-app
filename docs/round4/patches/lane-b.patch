+      hd[o] = frac(c.x / tile); hd[o + 1] = frac(c.z / tile); hd[o + 2] = c.r / tile; hd[o + 3] = c.s;
+    }
+    ctx.hush.strength = strength;
+    ctx.water.hush.strength = strength;
+  },
+};
+
+export { HUSH };
